# Both halves are optional, so the PoC runs with none of this set:
# no HA_TOKEN uses the mock source, no WLED_IP prints the payload.

# --- Home Assistant ---------------------------------------------------------
# Leave HA_TOKEN empty to run against the mock source in source.ts.
HA_BASE_URL=http://homeassistant.local:8123
# Profile -> Security -> Long-lived access tokens -> Create token
HA_TOKEN=

# --- WLED -------------------------------------------------------------------
# These two SEED panel.config.json the first time it is written, and after that
# the file wins — they are editable in the editor, so changing them here later
# has no effect. Delete panel.config.json to seed it again.
# Leave WLED_IP empty to print the /json/state body instead of posting it.
WLED_IP=
WLED_BRIGHTNESS=96

# --- Behaviour --------------------------------------------------------------
# Seeds the dwell on the default flow's rotation, same as above: once
# panel.config.json exists, each rotation carries its own dwell.
ROTATE_SECONDS=5
# Mock source only: how long each step of its script holds.
MOCK_STEP_SECONDS=8

# --- The editor -------------------------------------------------------------
# Where the configuration UI is served. Loopback only, and unauthenticated.
PORT=8000
